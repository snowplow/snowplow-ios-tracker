ntifier","text":"RemoteConfiguration"}],"kind":"symbol","identifier":"doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/RemoteConfiguration","role":"symbol","title":"RemoteConfiguration"},"doc://SnowplowTracker/documentation/SnowplowTracker/ConfigurationBundle":{"role":"symbol","navigatorTitle":[{"text":"ConfigurationBundle","kind":"identifier"}],"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConfigurationBundle","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/ConfigurationBundle","title":"ConfigurationBundle","abstract":[{"type":"text","text":"This class represents the default configuration applied in place of the remote configuration."}],"url":"\/documentation\/snowplowtracker\/configurationbundle"},"doc://SnowplowTracker/documentation/SnowplowTracker/Snowplow/setup(remoteConfiguration:defaultConfiguration:defaultConfigurationVersion:onSuccess:)":{"kind":"symbol","type":"topic","identifier":"doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/Snowplow\/setup(remoteConfiguration:defaultConfiguration:defaultConfigurationVersion:onSuccess:)","url":"\/documentation\/snowplowtracker\/snowplow\/setup(remoteconfiguration:defaultconfiguration:defaultconfigurationversion:onsuccess:)","title":"setup(remoteConfiguration:defaultConfiguration:defaultConfigurationVersion:onSuccess:)","abstract":[{"type":"text","text":"Setup a single or a set of tracker instances which will be used inside the app to track events."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setup"},{"kind":"text","text":"("},{"kind":"externalParam","text":"remoteConfiguration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@M@SnowplowTracker@objc(cs)SPRemoteConfiguration","text":"RemoteConfiguration"},{"kind":"text","text":", "},{"kind":"exte