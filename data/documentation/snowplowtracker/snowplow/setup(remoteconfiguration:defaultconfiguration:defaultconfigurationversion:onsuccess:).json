nState","identifier":"doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/ConfigurationState","preciseIdentifier":"c:@M@SnowplowTracker@E@SPConfigurationState","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":")","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The remote configuration used to indicate where to download the configuration from."}],"type":"paragraph"}],"name":"remoteConfiguration"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The default configuration passed by default in case there isn’t a cached version and it’s able to download a new one."}]}],"name":"defaultBundles"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Version of the default configuration that will be used to compare with the fetched remote config to decide whether to replace it."}]}],"name":"defaultBundleVersion"},{"content":[{"inlineContent":[{"type":"text","text":"The callback called when a configuration (cached or downloaded) is set."},{"type":"text","text":" "},{"type":"text","text":"It passes two arguments: list of the namespaces associated to the created trackers"},{"type":"text","text":" "},{"type":"text","text":"and the state of the configuration – whether it was retrieved from cache or fetched over the network."}],"type":"paragraph"}],"name":"onSuccess"}],"kind":"parameters"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The app can run multiple tracker instances which will be identified by string ","type":"text"},{"code":"namespaces","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The trackers configuration is automatically download from the endpoint indicated in the ","type":"text"},{"code":"RemoteConfiguration","type":"codeVoice"},{"text":" ","type":"text"},{"text":"passed as argument. For more details see ","type":"text"},{"code":"RemoteConfiguration","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The method is asynchronous and you can receive the list of the created trackers in the callbacks once the trackers are created.","type":"text"},{"text":" ","type":"text"},{"text":"The callback can be called multiple times in case a cached configuration is ready and later a fetched configuration is available.","type":"text"},{"text":" ","type":"text"},{"text":"You can also pass as argument a default configuration in case there isn’t a cached configuration and it’s not able to download","type":"text"},{"text":" ","type":"text"},{"text":"a new one. The downloaded configuration updates the cached one only if the configuration version is greater than the cached one.","type":"text"},{"text":" ","type":"text"},{"text":"Otherwise the cached one is kept and the callback is not called.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"IMPORTANT: The EventStore will persist all the events that have been tracked but not yet sent.","type":"text"},{"text":" ","type":"text"},{"text":"Those events are attached to the namespace.","type":"text"},{"text":" ","type":"text"},{"text":"If the tracker is removed or the app relaunched with a different namespace, those events can’t","type":"text"},{"text":" ","type":"text"},{"text":"be sent to the collector and they remain in a zombie state inside the EventStore.","type":"text"},{"text":" ","type":"text"},{"text":"To remove all the zombie events you can call an internal method ","type":"text"},{"code":"removeUnsentEventsExceptForNamespaces","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"SPSQLEventStore","type":"codeVoice"},{"text":" ","type":"text"},{"text":"which will delete all the EventStores instanced with namespaces not listed in the passed list.","type":"text"}]}],"kind":"conten