ext":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setup"},{"kind":"text","text":"("},{"kind":"externalParam","text":"remoteConfiguration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@M@SnowplowTracker@objc(cs)SPRemoteConfiguration","text":"RemoteConfiguration","identifier":"doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/RemoteConfiguration"},{"kind":"text","text":", "},{"kind":"externalParam","text":"defaultConfiguration"},{"kind":"text","text":" "},{"kind":"internalParam","text":"defaultBundles"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"c:@M@SnowplowTracker@objc(cs)SPConfigurationBundle","text":"ConfigurationBundle","identifier":"doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/ConfigurationBundle"},{"kind":"text","text":"]?, "},{"kind":"externalParam","text":"defaultConfigurationVersion"},{"kind":"text","text":" "},{"kind":"internalParam","text":"defaultBundleVersion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = NSInteger.min, "},{"kind":"externalParam","text":"onSuccess"},{"kind":"text","text":": "},{"kind":"keyword","text":"@escaping"},{"kind":"text","text":" (["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]?, "},{"kind":"typeIdentifier","preciseIdentifier":"c:@M@SnowplowTracker@E@SPConfigurationState","text":"ConfigurationState","identifier":"doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/ConfigurationState"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":")"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"The remote configuration used to indicate where to download the configuration from.","type":"text"}],"type":"paragraph"}],"name":"remoteConfiguration"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The default configuration passed by default in case there isn’t a cached version and it’s able to download a new one."}]}],"name":"defaultBundles"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Version of the default configuration that will be used to compare with the fetched remote config to decide whether to replace it."}]}],"name":"defaultBundleVersion"},{"content":[{"inlineContent":[{"text":"The callback called when a configuration (cached or downloaded) is set.","type":"text"},{"text":" ","type":"text"},{"text":"It passes two arguments: list of the namespaces associated to the created trackers","type":"text"},{"text":" ","type":"text"},{"text":"and the state of the configuration – whether it was retrieved from cache or fetched over the network.","type":"text"}],"type":"paragraph"}],"name":"onSuccess"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The app can run multiple tracker instances which will be identified by string ","type":"text"},{"type":"codeVoice","code":"namespaces"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The trackers configuration is automatically download from the endpoint indicated in the ","type":"text"},{"type":"codeVoice","code":"RemoteConfiguration"},{"text":" ","type":"text"},{"text":"passed as argument. For more details see ","type":"text"},{"type":"codeVoice","code":"RemoteConfiguration"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The method is asynchronous and you can receive the list of the created trackers in the callbacks once the trackers are created.","type":"text"},{"text":" ","type":"text"},{"text":"The callback can be called multiple times in case a cached configuration is ready and later a fetched configuration is available.","type":"text"},{"text":" ","type":"text"},{"text":"You can also pass as argument a default configuration in case there isn’t a cached configuration and it’s not able to download","type":"text"},{"text":" ","type":"text"},{"text":"a new one. The downloaded configuration updates the cached one only if the configuration version is greater than the cached one.","type":"text"},{"text":" ","type":"text"},{"text":"Otherwise the cached one is kept and the callback is not called.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"IMPORTANT: The EventStore will persist all the events that have been tracked but not yet sent."},{"type":"text","text":" "},{"type":"text","text":"Those events are attached to the namespace."},{"type":"text","text":" "},{"type":"text","text":"If the tracker is removed or the app relaunched with a different namespace, those events can’t"},{"type":"text","text":" "},{"type":"text","text":"be sent to the collector and they remain in a zombie state inside the EventStore."},{"type":"text","text":" "},{"type":"text","text":"To remove all the zombie events you can call an internal method "},{"type":"codeVoice","code":"removeUnsentEventsExceptForNamespaces"},{"type":"text","text":" on "},{"type":"codeVoice","code":"SPSQLEventStore"},{"type":"text","text":" "},{"type":"text","text":"which will delete all the EventStores instanced with namespaces not listed in the passed list."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/snowplowtracker\/snowplow\/setup(remoteconfiguration:defaultconfiguration:defaultconfigurationversion:onsuccess:)"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker","doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/Snowplow"]]},"abstract":[{"text":"Setup a single or a set of tracker instances which will be used inside the app to track events.","type":"text"}],"sections