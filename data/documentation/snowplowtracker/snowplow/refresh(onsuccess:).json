{"abstract":[{"text":"Reconfigure, create or delete the trackers based on the configuration downloaded remotely.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"symbol","modules":[{"name":"SnowplowTracker"}],"title":"refresh(onSuccess:)","roleHeading":"Type Method","symbolKind":"method","externalID":"c:@M@SnowplowTracker@objc(cs)SPSnowplow(cm)refreshOnSuccess:","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refresh","kind":"identifier"},{"text":"(","kind":"text"},{"text":"onSuccess","kind":"externalParam"},{"text":": ([","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]?, ","kind":"text"},{"text":"ConfigurationState","kind":"typeIdentifier","preciseIdentifier":"c:@M@SnowplowTracker@E@SPConfigurationState"},{"text":") -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":")","kind":"text"}]},"hierarchy":{"paths":[["doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker","doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/Snowplow"]]},"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/snowplowtracker\/snowplow\/refresh(onsuccess:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"refresh"},{"kind":"text","text":"("},{"kind":"externalParam","text":"onSuccess"},{"kind":"text","text":": "},{"kind":"keyword","text":"@escaping"},{"kind":"text","text":" (["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"]?, "},{"preciseIdentifier":"c:@M@SnowplowTracker@E@SPConfigurationState","kind":"typeIdentifier","identifier":"doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/ConfigurationState","text":"ConfigurationState"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:s4Voida","kind":"typeIdentifier","text":"Void"},{"kind":"text","text":")"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The callback called when a configuration (cached or downloaded) is set It passes the list of the namespaces associated"},{"type":"text","text":" "},{"type":"text","text":"to the created trackers."}],"type":"paragraph"}],"name":"onSuccess"}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The trackers configuration is automatically download from the endpoint indicated in the "},{"type":"codeVoice","code":"RemoteConfiguration"},{"type":"text","text":" "},{"type":"text","text":"previously used to setup the trackers."}]},{"type":"paragraph","inlineContent":[{"text":"The method is asynchronous and you can receive the list of the created trackers in the callbacks once the trackers are created.","type":"text"},{"text":" ","type":"text"},{"text":"The downloaded configuration updates the cached one only if the configuration version is greater than the cached one.","type":"text"},{"text":" ","type":"text"},{"text":"Otherwise the cached one is kept and the callback is not called.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"IMPORTANT: The EventStore will persist all the events that have been tracked but not yet sent."},{"type":"text","text":" "},{"type":"text","text":"Those events are attached to the namespace."},{"type":"text","text":" "},{"type":"text","text":"If the tracker is removed or the app relaunched with a different namespace, those events can’t"},{"type":"text","text":" "},{"type":"text","text":"be sent to the collector and they remain in a zombie state inside the EventStore."},{"type":"text","text":" "},{"type":"text","text":"To remove all the zombie events you can call an internal method "},{"type":"codeVoice","code":"removeUnsentEventsExceptForNamespaces"},{"type":"text","text":" on "},{"type":"codeVoice","code":"SPSQLEventStore"},{"type":"text","text":" "},{"type":"text","text":"which will delete all the EventStores instanced with namespaces not listed in the passed list."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/Snowplow\/refresh(onSuccess:)"},"references":{"doc://SnowplowTracker/documentation/SnowplowTracker":{"type":"topic","url":"\/documentation\/snowplowtracker","title":"SnowplowTracker","identifier":"doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker","role":"collection","kind":"symbol","abstract":[]},"doc://SnowplowTracker/documentation/SnowplowTracker/ConfigurationState":{"navigatorTitle":[{"kind":"identifier","text":"ConfigurationState"}],"type":"topic","url":"\/documentation\/snowplowtracker\/configurationstate","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConfigurationState"}],"identifier":"doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/ConfigurationState","role":"symbol","abstract":[{"type":"text","text":"State of retrieved remote configuration that states where the configuration was retrieved from."}],"title":"ConfigurationState","kind":"symbol"},"doc://SnowplowTracker/documentation/SnowplowTracker/Snowplow/refresh(onSuccess:)":{"url":"\/documentation\/snowplowtracker\/snowplow\/refresh(onsuccess:)","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refresh","kind":"identifier"},{"text":"(","kind":"text"},{"text":"onSuccess","kind":"externalParam"},{"text":": ([","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{