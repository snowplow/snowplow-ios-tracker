{"hierarchy":{"paths":[["doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker","doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/Snowplow"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@objc","kind":"attribute"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"refresh","kind":"identifier"},{"text":"(","kind":"text"},{"text":"onSuccess","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping","kind":"keyword"},{"text":" ([","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]?, ","kind":"text"},{"text":"ConfigurationState","kind":"typeIdentifier","identifier":"doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/ConfigurationState","preciseIdentifier":"c:@M@SnowplowTracker@E@SPConfigurationState"},{"text":") -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":")","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"The callback called when a configuration (cached or downloaded) is set It passes the list of the namespaces associated","type":"text"},{"text":" ","type":"text"},{"text":"to the created trackers.","type":"text"}],"type":"paragraph"}],"name":"onSuccess"}],"kind":"parameters"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The trackers configuration is automatically download from the endpoint indicated in the "},{"type":"codeVoice","code":"RemoteConfiguration"},{"type":"text","text":" "},{"type":"text","text":"previously used to setup the trackers."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The method is asynchronous and you can receive the list of the created trackers in the callbacks once the trackers are created."},{"type":"text","text":" "},{"type":"text","text":"The downloaded configuration updates the cached one only if the configuration version is greater than the cached one."},{"type":"text","text":" "},{"type":"text","text":"Otherwise the cached one is kept and the callback is not called."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"IMPORTANT: The EventStore will persist all the events that have been tracked but not yet sent."},{"type":"text","text":" "},{"type":"text","text":"Those events are attached to the namespace."},{"type":"text","text":" "},{"type":"text","text":"If the tracker is removed or the app relaunched with a different namespace, those events can’t"},{"type":"text","text":" "},{"type":"text","text":"be sent to the collector and they remain in a zombie state inside the EventStore."},{"type":"text","text":" "},{"type":"text","text":"To remove all the zombie events you can call an internal method "},{"code":"removeUnsentEventsExceptForNamespaces","type":"codeVoice"},{"type":"text","text":" on "},{"code":"SPSQLEventStore","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"which will delete all the EventStores instanced with namespaces not listed in the passed list."}]}],"kind":"content"}],"kind":"symbol","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/Snowplow\/refresh(onSuccess:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/snowplowtracker\/snowplow\/refresh(onsuccess:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Reconfigure, create or delete the trackers based on the configuration downloaded remotely."}],"metadata":{"modules":[{"name":"SnowplowTracker"}],"symbolKind":"method","title":"refresh(onSuccess:)","roleHeading":"Type Method","externalID":"c:@M@SnowplowTracker@objc(cs)SPSnowplow(cm)refreshOnSuccess:","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"refresh"},{"kind":"text","text":"("},{"kind":"externalParam","text":"onSuccess"},{"kind":"text","text":": (["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"]?, "},{"preciseIdentifier":"c:@M@SnowplowTracker@E@SPConfigurationState","kind":"typeIdentifier","text":"ConfigurationState"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:s4Voida","kind":"typeIdentifier","text":"Void"},{"kind":"text","text":")"}]},"references":{"doc://SnowplowTracker/documentation/SnowplowTracker/Snowplow":{"abstract":[{"text":"Entry point to instance a new Snowplow tracker.","type":"text"}],"type":"topic","title":"Snowplow","url":"\/documentation\/snowplowtracker\/snowplow","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Snowplow","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/Snowplow","kind":"symbol","navigatorTitle":[{"text":"Snowplow","kind":"identifier"}]},"doc://SnowplowTracker/documentation/SnowplowTracker/ConfigurationState":{"role":"symbol","abstract":[{"text":"State of retrieved remote configuration that states where the configuration was retrieved from.","type":"text"}],"navigatorTitle":[{"text":"ConfigurationState","kind":"identifier"}],"title":"ConfigurationState","kind":"symbol","url":"\/documentation\/snowplowtracker\/configurationstate","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConfigurationState","kind":"identifier"}],"identifier":"doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/ConfigurationState"},"doc://SnowplowTracker/documentation/SnowplowTracker/Snowplow/refresh(onSuccess:)":{"identifier":"doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/Snowplow\/refresh(onSuccess:)","type":"topic","url":"\/documentation\/snowplowtracker\/snowplow\/