: The EventStore will persist all the events that have been tracked but not yet sent."},{"type":"text","text":" "},{"type":"text","text":"Those events are attached to the namespace."},{"type":"text","text":" "},{"type":"text","text":"If the tracker is removed or the app relaunched with a different namespace, those events can’t"},{"type":"text","text":" "},{"type":"text","text":"be sent to the collector and they remain in a zombie state inside the EventStore."},{"type":"text","text":" "},{"type":"text","text":"To remove all the zombie events you can call an internal method "},{"type":"codeVoice","code":"removeUnsentEventsExceptForNamespaces"},{"type":"text","text":" on "},{"type":"codeVoice","code":"SPSQLEventStore"},{"type":"text","text":" "},{"type":"text","text":"which will delete all the EventStores instanced with namespaces not listed in the passed list."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker","doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/Snowplow"]]},"references":{"doc://SnowplowTracker/documentation/SnowplowTracker/HttpMethodOptions":{"navigatorTitle":[{"kind":"identifier","text":"HttpMethodOptions"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HttpMethodOptions"}],"url":"\/documentation\/snowplowtracker\/httpmethodoptions","abstract":[{"type":"text","text":"An enum for HTTP method types."}],"title":"HttpMethodOptions","type":"topic","identifier":"doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker\/HttpMethodOptions","role":"symbol"},"doc://SnowplowTracker/documentation/SnowplowTracker":{"kind":"symbol","url":"\/documentation\/snowplowtracker","role":"collection","abstract":[],"title":"SnowplowTracker","identifier":"doc:\/\/SnowplowTracker\/documentation\/SnowplowTracker","type":"topic"},"doc://SnowplowTracker/documentation/SnowplowTracker/ConfigurationBuilder":{"navigator