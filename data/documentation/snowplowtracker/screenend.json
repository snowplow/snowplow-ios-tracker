{"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScreenEnd","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"text":"This event is tracked automatically before each ","type":"text"},{"code":"ScreenView","type":"codeVoice"},{"text":" event when screen engagement","type":"text"},{"text":" ","type":"text"},{"text":"tracking is enabled, closing out the engagement summary for the previous screen.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It can also be tracked manually to end the current screen without starting a new one –","type":"text"},{"text":" ","type":"text"},{"text":"for instance when a WebView is presented over a native screen, or when a screen is","type":"text"},{"text":" ","type":"text"},{"text":"dismissed without a subsequent screen view being tracked. Tracking it manually stops the","type":"text"},{"text":" ","type":"text"},{"text":"engagement timer for the current screen and attaches the ","type":"text"},{"code":"screen_summary","type":"codeVoice"},{"text":" entity.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"After the screen ends, the "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" and "},{"type":"codeVoice","code":"screen_summary"},{"type":"text","text":" entities are no longer attached to"},{"type":"text","text":" "},{"type":"text","text":"subsequent events until the next "},{"type":"codeVoice","code":"ScreenView"},{"type":"text","text":". The next "},{"type":"codeVoice","code":"ScreenView"},{"type":"text","text":" still references the"},{"type":"text","text":" "},{"type":"text","text":"ended screen in its previous screen fields and no further "},{"type":"codeVoice","code":"ScreenEnd"},{"type":"text","text":" is tracked for it."}],"type":"paragraph"},{"inli